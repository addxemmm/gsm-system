+		LOG(ALERT) << "UHD: First receive after timeout starts too late";
+		LOG(ALERT) << "Requested tick " << requested_ts
+			   << ", received tick " << packet_ts;
+		return ERROR_UNRECOVERABLE;
+	}
 
 	// Monotonicity check
 	if (ts < prev_ts) {
 		LOG(ALERT) << "UHD: Loss of monotonic time";
 		LOG(ALERT) << "Current time: " << ts.get_real_secs() << ", " 
 			   << "Previous time: " << prev_ts.get_real_secs();
+		if (require_contiguous)
+			return ERROR_UNRECOVERABLE;
 		return ERROR_TIMING;
 	} else {
 		prev_ts = ts;
 	}
 
+	rx_pkt_end_ts = packet_ts + num_smpls;
+	rx_pkt_end_valid = true;
+
 	return 0;
 }
 
