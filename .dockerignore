# Keep the build context small: the fresh image builds OpenBTS from
# source, so legacy binaries/logs/DB copies must not be sent to the daemon.
/.git/
**/.git/
bin/
var/
TempFile/
image/
gsmsystem/log/
gsmsystem/smqueue.db
gsmsystem/smqueue_5.0_amd64.deb
*.pdf
*.pcap
*.log
# Stale prefetch dir from the first attempt (renamed to third_party/).
vendor/
.env
.env.*
.release-revision
__pycache__/
.codex-go-cache-release/
crash/
*_run.conf
