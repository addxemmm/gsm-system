# Optional API Bearer token. Blank disables authentication; nonblank enables it.
# 可选 API Bearer 令牌。留空关闭鉴权；非空启用鉴权。
GSM_API_TOKEN=

# Project timezone for the container, native logs and API display. Recreate the
# container after changes; this changes the zone, not the host/system clock.
# 项目时区（容器、原生日志及 API 展示），修改后重建容器；不修改宿主机时钟。
TZ=Asia/Shanghai

# New volumes enable GPRS by default. Use an upstream DNS reachable from the
# handset pool; never a loopback stub such as 127.0.0.11. Existing DBs are unchanged.
# 新卷默认启用 GPRS；DNS 填手机地址池可达的上游 IPv4，旧数据库不被覆盖。
GSM_GPRS_DNS=1.1.1.1

# Web bind interface; use a LAN address to restrict exposure.
# Web 发布地址，建议设置为实际 LAN 地址以限制暴露范围。
GSM_BIND_ADDRESS=0.0.0.0
GSM_WEB_PORT=18082

# deploy_to_ubuntu.sh reads this flag without executing .env. Default false
# publishes Web only; true also applies docker-compose.api.yml for API clients.
# 部署脚本读取此开关（不会执行 .env），true 同时发布独立 API，默认仅 Web。
# Direct `docker compose` users must explicitly merge the API overlay themselves.
# 直接调用 docker compose 的用户必须自行显式合并 API overlay。
GSM_EXPOSE_API=false
GSM_API_PORT=8082

# Optional exact public Web origin when a trusted TLS proxy terminates HTTPS.
# 仅在可信 TLS 代理终止 HTTPS 时填写精确 Web origin；直连 LAN 留空。
# Example / 示例: https://gsm.example.invalid (no path / 不带路径)
GSM_WEB_PUBLIC_ORIGIN=

# Dedicated Docker bridge. It must not overlap host/LAN/LTE or OpenBTS GPRS
# 192.168.99.0/24 routes. 不得与宿主机、LAN、LTE 或 GPRS 网段重叠。
GSM_BRIDGE_SUBNET=172.31.240.0/24
