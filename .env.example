# Optional API Bearer token. Blank disables authentication; nonblank enables it.
# 可选 API Bearer 令牌。留空关闭鉴权；非空启用鉴权。
GSM_API_TOKEN=

# Host address that publishes the management API on TCP 8082. Use the SDR
# host's LAN address to restrict it to one interface; 0.0.0.0 publishes on all.
# 将管理 API TCP 8082 发布到的宿主机地址；填 SDR 主机 LAN 地址可限制网卡。
GSM_BIND_ADDRESS=0.0.0.0

# Dedicated Docker bridge. It must not overlap host/LAN/LTE or OpenBTS GPRS
# 192.168.99.0/24 routes. 不得与宿主机、LAN、LTE 或 GPRS 网段重叠。
GSM_BRIDGE_SUBNET=172.31.240.0/24
