 	}
 
 	ts = md.time_spec;
+	TIMESTAMP packet_ts = ts.to_ticks(rx_rate);
+
+	// A timeout is harmless only if the resumed packet is exactly contiguous.
+	// 超时恢复后的首包必须连续，避免把环形缓冲区空洞作为 I/Q 样本读取。
+	if (require_contiguous && rx_pkt_end_valid &&
